#!/bin/sh
# Camera bring-up check: with the mt9m114 device-tree variant the capture
# pipeline (mt9m114 sensor -> parallel-CSI -> ISI) should bind and the V4L2
# media graph should register a media device, subdevs, and video nodes.
PATH=/sbin:/usr/sbin:/bin:/usr/bin; export PATH
/bin/mount -t proc proc /proc 2>/dev/null
/bin/mount -t sysfs sysfs /sys 2>/dev/null
/bin/mount -t devtmpfs devtmpfs /dev 2>/dev/null
sleep 2

echo "=== CAMERA TEST ==="
echo "--- /dev/{media,video,v4l-subdev}* ---"
ls -l /dev/media* /dev/video* /dev/v4l-subdev* 2>/dev/null
echo "--- /sys/class/video4linux ---"
ls /sys/class/video4linux 2>/dev/null
echo "--- deferred probe ---"
cat /sys/kernel/debug/devices_deferred 2>/dev/null
echo "--- dmesg (sensor / pipeline) ---"
dmesg | grep -iE "mt9m114|MT9M114 is found|chip found|isi|parallel|v4l2|media" \
      | grep -ivE "dependency cycle" | tail -30
echo "=== CAMERA TEST DONE ==="
while true; do sleep 5; done
