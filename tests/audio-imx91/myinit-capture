#!/bin/sh
PATH=/sbin:/usr/sbin:/bin:/usr/bin; export PATH
/bin/mount -t proc proc /proc 2>/dev/null
/bin/mount -t sysfs sysfs /sys 2>/dev/null
/bin/mount -t devtmpfs devtmpfs /dev 2>/dev/null
/bin/mount -t debugfs none /sys/kernel/debug 2>/dev/null

echo "=== AUDIO-CAP: depmod + load SAI/MICFIL/codec drivers ==="
/sbin/depmod -a 2>/dev/null
# imx-card pulls in fsl-micfil + dmic for the MICFIL (PDM) capture card;
# fsl-asoc-card + wm8962 for the SAI3 card (both built-in or modular here).
for m in snd-soc-fsl-utils snd-soc-fsl-sai snd-soc-fsl-micfil imx-pcm-dma \
         snd-soc-dmic snd-soc-wm8962 snd-soc-fsl-asoc-card snd-soc-imx-card \
         snd-soc-simple-card snd-soc-simple-card-utils; do
    /sbin/modprobe "$m" 2>&1 | sed "s/^/modprobe $m: /"
done
sleep 4
echo "=== /proc/asound/cards ==="
cat /proc/asound/cards 2>/dev/null
echo "=== /proc/asound/pcm ==="
cat /proc/asound/pcm 2>/dev/null

WCARD=$(awk '/wm8962|imx-audio-wm8962/{print $1}' /proc/asound/cards 2>/dev/null | head -1)
MCARD=$(awk '/micfil/{print $1}' /proc/asound/cards 2>/dev/null | head -1)
echo "wm8962 card = ${WCARD:-NONE}   micfil card = ${MCARD:-NONE}"

echo "CAPSTART" > /dev/kmsg 2>/dev/null

# SAI3/wm8962 capture (regression - already works end to end).
if [ -x /pcm_capture ] && [ -n "$WCARD" ]; then
    echo "=== CAPTURE on wm8962/SAI3 (hw:$WCARD,0) ==="
    /pcm_capture hw:$WCARD,0 4096
fi

# MICFIL (PDM) capture - the new path under test. Try 2ch (stock) and 8ch
# (the 8mic-reve DTB); the card's dmic-codec num-channels caps what succeeds.
if [ -n "$MCARD" ]; then
    if [ -x /pcm_capdiag ]; then
        echo "=== CAPTURE DIAG on MICFIL (hw:$MCARD,0) ==="
        /pcm_capdiag hw:$MCARD,0
    fi
    if [ -x /pcm_capture ]; then
        for ch in 2 8; do
            echo "=== CAPTURE on MICFIL (hw:$MCARD,0) ${ch}ch ==="
            /pcm_capture hw:$MCARD,0 4096 S32 $ch
        done
        # RATE-TRACKING proof: same 16000 frames at 48k then 16k.  With the feed
        # rate taken from the pdm_root clock, 16k takes ~0.67s LONGER than 48k;
        # a model that feeds a fixed 48kHz makes the two equal (harness asserts).
        for rate in 48000 16000; do
            echo "=== MICFIL RATE hw:$MCARD,0 16000 frames @ ${rate}Hz ==="
            /pcm_capture hw:$MCARD,0 16000 S32 2 $rate
        done
    fi
fi

echo "=== FULL DMESG since CAPSTART ==="
dmesg | sed -n '/CAPSTART/,$p' | tail -120
echo "=== AUDIO-CAP TEST DONE ==="
sync
/bin/poweroff -f 2>/dev/null
echo o > /proc/sysrq-trigger 2>/dev/null
sleep 10
